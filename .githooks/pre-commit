#!/bin/sh
# Blocks committing .env files or anything that looks like a Google API key.
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$'; then
  echo "pre-commit: refusing to commit .env file" >&2
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -E 'AIza[0-9A-Za-z_-]{35}'; then
  echo "pre-commit: Google API key found in staged changes" >&2
  exit 1
fi
